# Этот файл — документация переменных окружения.
# В сгенерированном продукте он лежит как .env.example (генератор переименовывает).
# Реальный .env генерирует CLI со случайными секретами.
# Локальные значения работают с docker-compose.dev.yml из коробки.

# --- Dev-порты хоста (меняй при конфликте с другими проектами) ---
# ВАЖНО: изменил порт — поправь и связанный URL ниже
# (PUBLIC_URL, INTERNAL_API_URL, DATABASE_URL, SMTP_URL, S3_ENDPOINT, REDIS_URL).
DEV_HTTP_PORT=8080
WEB_PORT=3000
DEV_POSTGRES_PORT=5432
DEV_MAILPIT_SMTP_PORT=1025
DEV_MAILPIT_UI_PORT=8025
DEV_GRAFANA_PORT=3001
DEV_OTLP_PORT=4318
DEV_MINIO_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001
DEV_REDIS_PORT=6379

# --- Core ---
NODE_ENV=development
# порт API на хосте в dev (в контейнере всегда 3000)
PORT=4000
PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info
SESSION_TTL_DAYS=30

# приложение ходит под app_user, миграции — под migrator
DATABASE_URL=postgres://app_user:app_user@localhost:5432/app
MIGRATE_DATABASE_URL=postgres://migrator:migrator@localhost:5432/app

# RSC → API внутри сети (в dev — хост, в проде http://api:3000/api/v1)
INTERNAL_API_URL=http://localhost:4000/api/v1

# --- Email (Core: Mailpit локально) ---
EMAIL_FROM=no-reply@localhost
SMTP_URL=smtp://localhost:1025
EMAIL_PROVIDER=smtp
# провайдер в проде: EMAIL_PROVIDER=resend
RESEND_API_KEY=

# --- Observability (Core) ---
GRAFANA_ADMIN_PASSWORD=change-me
# канал алертов: telegram | email
ALERT_CHANNEL=telegram
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
# pull-uptime: URL от healthchecks.io
HEALTHCHECKS_URL=

# --- Postgres в контейнере (dev и staging) ---
POSTGRES_PASSWORD=postgres

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=test
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# включает экспорт трейсов: http://localhost:4318 локально, http://tempo:4318 в проде
OTEL_EXPORTER_OTLP_ENDPOINT=
