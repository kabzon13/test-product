{
  "uid": "app-nodejs",
  "title": "Node.js",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Heap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "nodejs_heap_size_used_bytes", "legendFormat": "used" },
        { "refId": "B", "expr": "nodejs_heap_size_total_bytes", "legendFormat": "total" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event loop lag (p50/p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "nodejs_eventloop_lag_p50_seconds", "legendFormat": "p50" },
        { "refId": "B", "expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC time/s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (kind) (rate(nodejs_gc_duration_seconds_sum[5m]))", "legendFormat": "{{kind}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"api\"}[5m])", "legendFormat": "cpu" }
      ]
    },
    {
      "type": "timeseries",
      "title": "RSS",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=\"api\"}", "legendFormat": "rss" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active handles / requests",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "nodejs_active_handles_total", "legendFormat": "handles" },
        { "refId": "B", "expr": "nodejs_active_requests_total", "legendFormat": "requests" }
      ]
    }
  ]
}
