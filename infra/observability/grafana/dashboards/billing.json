{
  "uid": "app-billing",
  "title": "Billing (Stripe)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Запросы к /billing",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(http_requests_total{route=~\".*billing.*\"}[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ошибки вебхуков (5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{route=~\".*billing/webhook.*\",status=~\"4..|5..\"}[5m]))",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Stripe события в логах",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{job=\"docker\", container=~\".*api.*\"} |~ `(?i)stripe`" }
      ]
    }
  ]
}
