# Multi-stage: build в полном workspace, runtime — только prod-деплой пакета.
FROM node:24.6.0-alpine AS build
RUN corepack enable
WORKDIR /repo

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY packages/config/package.json packages/config/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/api-client/package.json packages/api-client/
RUN pnpm install --frozen-lockfile --filter "@test/api..."

COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm --filter @test/config build && pnpm --filter @test/api build
# prod-зависимости + dist + migrations (см. "files" в package.json)
RUN pnpm --filter @test/api deploy --prod /out

FROM node:24.6.0-alpine AS runtime
ENV NODE_ENV=production
ENV PORT=3000
ARG GIT_SHA=local
ENV GIT_SHA=$GIT_SHA
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY --from=build --chown=app:app /out ./
USER app
EXPOSE 3000
CMD ["node", "dist/main.js"]
