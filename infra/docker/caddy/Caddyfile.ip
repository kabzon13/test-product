# Базовая часть Caddyfile — есть всегда.
# deploy.sh собирает финальный Caddyfile: этот файл + Caddyfile.domain (если задан APP_DOMAIN).

{
	servers {
		# реальный IP клиента приходит от Cloudflare
		# диапазоны: https://www.cloudflare.com/ips-v4 (Actions раз в месяц проверяет расхождение)
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP
	}
}

# Запасной вход по IP: работает до появления домена и как обходной путь мимо Cloudflare.
# Снаружи его прикрывает firewall (admin_ips). tls internal = самоподписанный сертификат.
:443 {
	encode gzip
	# health API для uptime-cron (сам /health не под /api/*)
	handle /healthz {
		rewrite * /health
		reverse_proxy api:3000
	}
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3000
	}
	tls internal
}
