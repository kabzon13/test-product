{
  "name": "test",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @test/config build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @test/config build && pnpm -r typecheck",
    "test": "pnpm --filter @test/config build && pnpm -r test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.9.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
